@inherits ViewBase<LaunchView, LaunchViewModel>
@using Daybreak.Shared.Models
@using Daybreak.Shared.Models.ColorPalette
@page "/launch"

<div class="launch-container">
    <div class="account-grid">
        @foreach (var config in this.ViewModel.LaunchConfigurations)
        {
            <div class="account-card @(config.GameRunning || config.CanKill ? "running" : "")"
                 style="@this.GetCardStyle(config)">
                <div class="config-info">
                    <div class="config-name">@GetDisplayName(config)</div>
                    @if (!string.IsNullOrEmpty(config.Configuration?.ExecutablePath))
                    {
                        <div class="config-path" title="@config.Configuration.ExecutablePath">@config.Configuration.ExecutablePath</div>
                    }
                    @if (config.CanKill || config.CanAttach)
                    {
                        <div class="config-status">@(config.CanAttach ? "Running (API available)" : "Running")</div>
                    }
                </div>
                <button class="card-launch-button @(config.CanKill ? "kill" : "")"
                        disabled="@(!this.ViewModel.CanInteract(config))"
                        @onclick="() => this.ViewModel.LaunchConfiguration(config)">
                    @this.ViewModel.GetCardButtonText(config)
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string? AutoLaunchConfigurationId { get; set; }

    private static string GetDisplayName(LauncherViewContext config) =>
        config.Configuration?.Name is null or ""
            ? config.Configuration?.Credentials?.Username ?? "Unknown User"
            : config.Configuration.Name;

    private string GetCardStyle(LauncherViewContext config)
    {
        var colorName = config.Configuration?.Color;
        if (string.IsNullOrWhiteSpace(colorName))
        {
            return string.Empty;
        }

        var accentColor = AccentColor.Accents.FirstOrDefault(a => a.Name.ToString() == colorName);
        return accentColor is null ? string.Empty : $"border-left: 6px solid {accentColor.Hex};";
    }
}
